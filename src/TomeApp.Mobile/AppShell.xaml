<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:TomeApp.Mobile.Views"
       x:Class="TomeApp.Mobile.AppShell"
       Shell.NavBarIsVisible="False"
       TabBarBackgroundColor="{StaticResource Surface}"
       TabBarUnselectedColor="{StaticResource OnSurfaceVariant}"
       TabBarForegroundColor="{StaticResource Primary}">

    <Shell.Resources>
        <Style TargetType="TabBar">
            <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Surface}" />
        </Style>
    </Shell.Resources>

    <TabBar>
        <ShellContent Title="Estante" Icon="icon_library.png" Route="library" ContentTemplate="{DataTemplate views:LibraryPage}" />
        <ShellContent Title="Cronômetro" Icon="icon_timer.png" Route="timer" ContentTemplate="{DataTemplate views:TimerPage}" />
        <ShellContent Title="Ranking" Icon="icon_trophy.png" Route="ranking" ContentTemplate="{DataTemplate views:RankingPage}" />
        <ShellContent Title="Perfil" Icon="icon_profile.png" Route="profile" ContentTemplate="{DataTemplate views:ProfilePage}" />
    </TabBar>
</Shell>
