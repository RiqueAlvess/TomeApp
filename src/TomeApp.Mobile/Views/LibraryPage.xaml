<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TomeApp.Mobile.ViewModels"
             xmlns:models="clr-namespace:TomeApp.Mobile.Models"
             x:Class="TomeApp.Mobile.Views.LibraryPage"
             x:DataType="vm:LibraryViewModel"
             Title="Minha Estante">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=AddBookCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <StackLayout Grid.Row="0" Padding="20,20,20,12">
            <Label Text="Sua Estante Digital" Style="{StaticResource HeadlineStyle}" />
            <Label Text="Organize sua jornada literária" Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" />
        </StackLayout>

        <!-- Filter Chips -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="12,0,12,12">
            <HorizontalStackLayout Spacing="8" Padding="8,4">
                <BindableLayout.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Todos</x:String>
                        <x:String>Lendo</x:String>
                        <x:String>Lidos</x:String>
                        <x:String>Quero ler</x:String>
                        <x:String>Abandonados</x:String>
                        <x:String>Favoritos</x:String>
                    </x:Array>
                </BindableLayout.ItemsSource>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border StrokeShape="RoundRectangle 99" Padding="16,8"
                                BackgroundColor="{StaticResource SurfaceContainerHighest}">
                            <Label Text="{Binding .}" FontSize="13" FontFamily="InterSemiBold"
                                   TextColor="{StaticResource OnSurfaceVariant}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ApplyFilterCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Book Grid -->
        <RefreshView Grid.Row="2" Command="{Binding LoadBooksCommand}" IsRefreshing="{Binding IsLoading}">
            <CollectionView ItemsSource="{Binding Books}" Margin="16,0" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="16" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Margin="0,60">
                        <Label Text="📚" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="Nenhum livro aqui ainda." Style="{StaticResource SubtitleStyle}" HorizontalOptions="Center" />
                        <Label Text="Toque em + para adicionar" FontSize="13" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                    </StackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:LocalBook">
                        <Grid RowDefinitions="*,Auto,Auto" RowSpacing="6">
                            <!-- Cover -->
                            <Border Grid.Row="0" StrokeShape="RoundRectangle 12" HeightRequest="180" Stroke="{StaticResource OutlineVariant}" StrokeThickness="0.5">
                                <Image Source="{Binding CoverUrl}" Aspect="AspectFill" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBookTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                            <!-- Progress bar -->
                            <ProgressBar Grid.Row="0" VerticalOptions="End" Progress="{Binding ProgressPercent, Converter={StaticResource PercentToDecimalConverter}}"
                                         ProgressColor="{StaticResource Primary}" BackgroundColor="#44000000" HeightRequest="4" />
                            <!-- Status Badge -->
                            <Border Grid.Row="0" HorizontalOptions="End" VerticalOptions="Start" Margin="6"
                                    BackgroundColor="{StaticResource PrimaryContainer}" StrokeShape="RoundRectangle 8" Padding="6,3">
                                <Label Text="{Binding Status}" FontSize="10" FontFamily="InterSemiBold" TextColor="White" />
                            </Border>
                            <!-- Title -->
                            <Label Grid.Row="1" Text="{Binding Title}" FontFamily="InterSemiBold" FontSize="14"
                                   TextColor="{StaticResource OnSurface}" LineBreakMode="TailTruncation" MaxLines="1" />
                            <!-- Author -->
                            <Label Grid.Row="2" Text="{Binding Author}" FontSize="12"
                                   TextColor="{StaticResource OnSurfaceVariant}" LineBreakMode="TailTruncation" MaxLines="1" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- FAB -->
        <Button Grid.Row="2" Text="+" VerticalOptions="End" HorizontalOptions="End"
                Margin="0,0,20,20" WidthRequest="56" HeightRequest="56" CornerRadius="28"
                BackgroundColor="{StaticResource Primary}" TextColor="White" FontSize="24"
                Clicked="OnAddBookClicked"
                Shadow="{Shadow Brush=Black, Offset='0,4', Radius=12, Opacity=0.25}" />
    </Grid>
</ContentPage>
