<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TomeApp.Mobile.ViewModels"
             x:Class="TomeApp.Mobile.Views.TimerPage"
             x:DataType="vm:TimerViewModel"
             Title="Cronômetro"
             BackgroundColor="#1e1b18">

    <Grid RowDefinitions="*,Auto">

        <StackLayout Grid.Row="0" VerticalOptions="Center" HorizontalOptions="Center" Spacing="32" Padding="24">

            <!-- Book Picker -->
            <StackLayout Spacing="8">
                <Label Text="LENDO AGORA" FontSize="11" FontFamily="InterSemiBold" LetterSpacing="2"
                       TextColor="#594143" HorizontalOptions="Center" />
                <Picker Title="Selecionar livro" ItemsSource="{Binding ReadingBooks}"
                        ItemDisplayBinding="{Binding Title}" SelectedItem="{Binding CurrentBook}"
                        BackgroundColor="#2a2520" TextColor="White" TitleColor="#594143"
                        HorizontalOptions="FillAndExpand" />
            </StackLayout>

            <!-- Timer Display -->
            <Label Text="{Binding ElapsedDisplay}" FontSize="72" FontFamily="PlayfairBold"
                   TextColor="White" HorizontalOptions="Center"
                   Shadow="{Shadow Brush='#b32349', Offset='0,0', Radius=20, Opacity=0.5}" />

            <!-- Start/Stop Button -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Button Grid.Column="0" Text="▶  Iniciar" Command="{Binding StartTimerCommand}"
                        IsVisible="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                        FontFamily="InterSemiBold" FontSize="16" CornerRadius="16" HeightRequest="60" />
                <Button Grid.Column="1" Grid.ColumnSpan="2" Text="⏹  Parar" Command="{Binding StopTimerCommand}"
                        IsVisible="{Binding IsRunning}"
                        BackgroundColor="#944a19" TextColor="White"
                        FontFamily="InterSemiBold" FontSize="16" CornerRadius="16" HeightRequest="60" />
            </Grid>

            <!-- Start page input (shown when not running) -->
            <StackLayout IsVisible="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" Spacing="8">
                <Label Text="Página inicial" FontSize="13" TextColor="#594143" />
                <Entry Text="{Binding StartPage}" Keyboard="Numeric"
                       BackgroundColor="#2a2520" TextColor="White" PlaceholderColor="#594143"
                       Placeholder="0" />
            </StackLayout>
        </StackLayout>

        <!-- Stop Dialog Overlay -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding ShowStopDialog}" BackgroundColor="#CC000000">
            <Frame BackgroundColor="{StaticResource Surface}" CornerRadius="24" Margin="24"
                   VerticalOptions="Center" Padding="24" HasShadow="True">
                <StackLayout Spacing="20">
                    <Label Text="Em qual página você parou?" FontFamily="PlayfairBold" FontSize="22"
                           TextColor="{StaticResource OnSurface}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <Entry Text="{Binding EndPage}" Keyboard="Numeric" Placeholder="Número da página"
                           HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" FontSize="24" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0" Text="Cancelar" Command="{Binding CancelStopCommand}"
                                BackgroundColor="{StaticResource SurfaceContainerHighest}"
                                TextColor="{StaticResource OnSurfaceVariant}"
                                FontFamily="InterSemiBold" CornerRadius="12" HeightRequest="52" />
                        <Button Grid.Column="1" Text="Salvar sessão" Command="{Binding ConfirmStopCommand}"
                                BackgroundColor="{StaticResource Primary}" TextColor="White"
                                FontFamily="InterSemiBold" CornerRadius="12" HeightRequest="52" />
                    </Grid>
                </StackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
